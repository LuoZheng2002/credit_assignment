FROM nvidia/cuda:13.0.3-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_HOME=/root/.rustup
ENV CARGO_HOME=/root/.cargo
ENV CUDA_HOME=/usr/local/cuda
ENV CUDA_PATH=/usr/local/cuda
ENV PATH=/root/.cargo/bin:/usr/local/bin:${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}
ENV UV_HTTP_TIMEOUT=300
ENV UV_HTTP_RETRIES=5

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    git \
    libnuma1 \
    libnuma-dev \
    ninja-build \
    pkg-config \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

RUN python --version \
    && nvcc --version \
    && ninja --version \
    && python -c "import ctypes.util, sysconfig; assert ctypes.util.find_library('numa'), 'libnuma missing'; include_dir = sysconfig.get_config_var('INCLUDEPY'); assert include_dir, 'python include dir missing'; print(include_dir)"

RUN curl -fsSL https://sh.rustup.rs | bash -s -- -y --profile minimal --default-toolchain stable

COPY --from=ghcr.io/astral-sh/uv:0.8.3 /uv /uvx /usr/local/bin/

WORKDIR /workspace

# Copy only dependency manifests so source changes do not invalidate the image.
COPY pyproject.toml uv.lock ./
COPY Cargo.toml Cargo.lock ./
COPY pyprojects/sglang/pyproject.toml ./pyprojects/sglang/pyproject.toml
COPY pyprojects/sglang/uv.lock ./pyprojects/sglang/uv.lock
COPY research-utility/pyproject.toml ./research-utility/pyproject.toml
COPY research-utility/Cargo.toml ./research-utility/Cargo.toml
COPY research-utility/Cargo.lock ./research-utility/Cargo.lock

# Bake third-party Python dependencies into the image without baking local source
# trees; Modal uploads the source separately at runtime via .modalignore.
RUN uv sync --frozen --no-install-project --no-install-package research-utility
RUN uv sync --frozen --project pyprojects/sglang --no-install-project

# Pre-populate the Cargo registry and git cache without compiling project targets.
# Cargo requires target files to exist when parsing a manifest, so create tiny
# stubs here instead of copying the real Rust source into the image.
RUN mkdir -p src research-utility/src \
    && printf 'pub fn _dependency_prefetch_stub() {}\n' > src/lib.rs \
    && printf 'fn main() {}\n' > src/main.rs \
    && printf 'pub fn _dependency_prefetch_stub() {}\n' > research-utility/src/lib.rs \
    && printf 'fn main() {}\n' > research-utility/src/main.rs
RUN cargo fetch --locked --manifest-path Cargo.toml
RUN cargo fetch --locked --manifest-path research-utility/Cargo.toml

ENV VIRTUAL_ENV=/workspace/.venv
ENV PATH=${VIRTUAL_ENV}/bin:${PATH}
ENV PYTHONPATH=/workspace:/workspace/research-utility/src_py

CMD ["bash"]

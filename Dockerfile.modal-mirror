FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_HOME=/root/.rustup
ENV CARGO_HOME=/root/.cargo
ENV PATH=/root/.cargo/bin:/usr/local/bin:${PATH}
ENV UV_HTTP_TIMEOUT=300
ENV UV_HTTP_RETRIES=5

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    git \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://sh.rustup.rs | bash -s -- -y --profile minimal --default-toolchain stable

COPY --from=ghcr.io/astral-sh/uv:0.8.3 /uv /uvx /usr/local/bin/

WORKDIR /workspace

# Copy dependency manifests and local path dependencies first for better cache reuse.
COPY pyproject.toml uv.lock ./
COPY Cargo.toml Cargo.lock ./
COPY pyprojects/sglang/pyproject.toml ./pyprojects/sglang/pyproject.toml
COPY research-utility ./research-utility

# Root python env (./.venv) and SGLang python env (./pyprojects/sglang/.venv).
RUN uv sync
RUN uv sync --project pyprojects/sglang

# Copy runtime source needed by orchestrator, wrappers, and training/inference paths.
COPY src ./src
COPY src_py ./src_py
COPY config ./config
COPY tokenizers ./tokenizers

ENV VIRTUAL_ENV=/workspace/.venv
ENV PATH=${VIRTUAL_ENV}/bin:${PATH}
ENV PYTHONPATH=/workspace

CMD ["bash"]

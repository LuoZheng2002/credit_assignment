FROM nvidia/cuda:13.0.3-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_HOME=/root/.rustup
ENV CARGO_HOME=/root/.cargo
ENV CUDA_HOME=/usr/local/cuda
ENV CUDA_PATH=/usr/local/cuda
ENV PATH=/root/.cargo/bin:/usr/local/bin:${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}
ENV UV_HTTP_TIMEOUT=300
ENV UV_HTTP_RETRIES=5

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    git \
    libnuma1 \
    libnuma-dev \
    ninja-build \
    pkg-config \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

RUN python --version \
    && nvcc --version \
    && ninja --version \
    && python -c "import ctypes.util, sysconfig; assert ctypes.util.find_library('numa'), 'libnuma missing'; include_dir = sysconfig.get_config_var('INCLUDEPY'); assert include_dir, 'python include dir missing'; print(include_dir)"

RUN curl -fsSL https://sh.rustup.rs | bash -s -- -y --profile minimal --default-toolchain stable

COPY --from=ghcr.io/astral-sh/uv:0.8.3 /uv /uvx /usr/local/bin/

WORKDIR /workspace

# Copy dependency manifests and local path dependencies first for better cache reuse.
COPY pyproject.toml uv.lock ./
COPY Cargo.toml Cargo.lock ./
COPY pyprojects/sglang/pyproject.toml ./pyprojects/sglang/pyproject.toml
COPY research-utility ./research-utility

# Root python env (./.venv) and SGLang python env (./pyprojects/sglang/.venv).
RUN uv sync
RUN uv sync --project pyprojects/sglang

# Copy the full repository contents that are allowed by .dockerignore,
# including datasets/ and any other runtime inputs.
COPY . .

ENV VIRTUAL_ENV=/workspace/.venv
ENV PATH=${VIRTUAL_ENV}/bin:${PATH}
ENV PYTHONPATH=/workspace

CMD ["bash"]

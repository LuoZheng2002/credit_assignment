# Modal runtime workspace upload list for add_local_dir.
# Keep this aligned with the repository inputs required by the Modal app.
*

!Dockerfile.modal-mirror
!pyproject.toml
!uv.lock
!Cargo.toml
!Cargo.lock
!README.md
!.env

# Upload live source and runtime inputs to Modal so source changes do not force
# an image rebuild.
!src/
!src/**
!src_py/
!src_py/**
!config/
!config/**
!tokenizers/
!tokenizers/**
!datasets/
!datasets/**

!research-utility/
!research-utility/Cargo.toml
!research-utility/Cargo.lock
!research-utility/pyproject.toml
!research-utility/src/
!research-utility/src/**
!research-utility/src_py/
!research-utility/src_py/**

!pyprojects/
!pyprojects/sglang/
!pyprojects/sglang/pyproject.toml
!pyprojects/sglang/uv.lock

# Re-exclude generated artifacts that can appear inside allowlisted trees.
**/.venv/
**/.venv/**
pyprojects/sglang/.venv/
pyprojects/sglang/.venv/**
**/__pycache__/
**/__pycache__/**
**/*.pyc
**/target/
**/target/**
research-utility/target/
research-utility/target/**
results/
results_version_tracking/
logs/
modal_downloads

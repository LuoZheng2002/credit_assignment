# Isolated VERL GRPO one-step-off async smoke test.
# Uses separate resource pools: 3 GPUs for FSDP training and 1 GPU for vLLM rollout.
EXPERIMENT_NAME=qwen25_hybrid_grpo_lora_r32_4gpu_3train_one_step_off_smoke
MODEL_PATH=Qwen/Qwen2.5-7B-Instruct
NUM_GPUS=4
VERL_ONE_STEP_OFF=True
TRAINING_GPUS=3
ROLLOUT_GPUS=1
ROLLOUT_TENSOR_MODEL_PARALLEL_SIZE=1
MODEL_ATTN_IMPLEMENTATION=sdpa
LORA_RANK=32
LORA_ALPHA=64
LEARNING_RATE=5e-6
TRAIN_BATCH_SIZE=12
PPO_MINI_BATCH_SIZE=12
PPO_MICRO_BATCH_SIZE_PER_GPU=1
LOG_PROB_MICRO_BATCH_SIZE_PER_GPU=1
ROLLOUT_N=1
MAX_PROMPT_LENGTH=1024
MAX_RESPONSE_LENGTH=1024
MAX_NUM_BATCHED_TOKENS=2048
MAX_NUM_SEQS=16
GPU_MEMORY_UTILIZATION=0.8
KL_LOSS_COEF=0.001
TOTAL_EPOCHS=1
TOTAL_TRAINING_STEPS=2
TEST_FREQ=1
SAVE_FREQ=-1
VAL_BEFORE_TRAIN=False
TRAIN_LIMIT=12
VAL_LIMIT=8
DATA_DIR=/work/nvme/bhph/zluo8/credit_assignment/results/verl_grpo_data/qwen25_hybrid_grpo_lora_r32_4gpu_3train_one_step_off_smoke
OUTPUT_DIR=/work/nvme/bhph/zluo8/credit_assignment/results/verl_grpo_runs/qwen25_hybrid_grpo_lora_r32_4gpu_3train_one_step_off_smoke
VERL_REWARD_OVERRIDE_PREFIX=custom_reward_function
VERL_RUN_DIR=/work/nvme/bhph/zluo8/credit_assignment/src/verl-main

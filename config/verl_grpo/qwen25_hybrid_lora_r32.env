# Isolated VERL GRPO experiment on raw hybrid_train/hybrid_val parquet.
# This file is sourced by scripts/verl_grpo/run_hybrid_grpo.sh.
EXPERIMENT_NAME=qwen25_hybrid_grpo_lora_r32
MODEL_PATH=Qwen/Qwen2.5-7B-Instruct
NUM_GPUS=1
LORA_RANK=32
LORA_ALPHA=64
LEARNING_RATE=5e-6
TRAIN_BATCH_SIZE=64
PPO_MINI_BATCH_SIZE=16
PPO_MICRO_BATCH_SIZE_PER_GPU=1
LOG_PROB_MICRO_BATCH_SIZE_PER_GPU=1
ROLLOUT_N=4
MAX_PROMPT_LENGTH=1024
MAX_RESPONSE_LENGTH=1024
MAX_NUM_BATCHED_TOKENS=4096
MAX_NUM_SEQS=64
GPU_MEMORY_UTILIZATION=0.70
KL_LOSS_COEF=0.001
TOTAL_EPOCHS=1
TOTAL_TRAINING_STEPS=-1
TEST_FREQ=5
SAVE_FREQ=5
VAL_BEFORE_TRAIN=True
# Optional smoke limits. Leave empty for the full hybrid files.
TRAIN_LIMIT=
VAL_LIMIT=
DATA_DIR=/work/nvme/bhph/zluo8/credit_assignment/results/verl_grpo_data/qwen25_hybrid_grpo_lora_r32
OUTPUT_DIR=/work/nvme/bhph/zluo8/credit_assignment/results/verl_grpo_runs/qwen25_hybrid_grpo_lora_r32
# Latest docs use custom_reward_function; some newer examples use reward.custom_reward_function.
VERL_REWARD_OVERRIDE_PREFIX=custom_reward_function

# Ignore everything by default, then allowlist only required paths.
*

!Dockerfile.modal-mirror
!pyproject.toml
!uv.lock
!Cargo.toml
!Cargo.lock
!README.md
!.env

# Keep only dependency manifests in the Docker build context; project source is
# provided to Modal separately at runtime via .modalignore.
!pyprojects/
!pyprojects/sglang/
!pyprojects/sglang/pyproject.toml
!pyprojects/sglang/uv.lock
!research-utility/
!research-utility/pyproject.toml
!research-utility/Cargo.toml
!research-utility/Cargo.lock

# Re-exclude generated artifacts that can appear inside allowlisted trees.
**/.venv/
**/.venv/**
**/__pycache__/
**/__pycache__/**
**/*.pyc
target/
results/
results_version_tracking/
logs/
modal_downloads

# Exclude runtime-written config from Docker build context while keeping it in the
# Modal runtime mount via .modalignore.
src_py/modal/orchestrator_config.json
src_py/modal/orchestrator_config.lock
src_py/modal/test_config.json
src_py/modal/test_config.lock
cache/
